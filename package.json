{
  "private": true,
  "name": "christmas-tombola",
  "version": "0.0.0",
  "license": "ISC",
  "repository": "github:julien-f/christmas-tombola",
  "author": {
    "name": "Julien Fontanet",
    "email": "julien.fontanet@isonoe.net"
  },
  "bin": {
    "christmas-tombola": "cli.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "app-conf": "^6.0.0",
    "handlebars": "^4.7.10",
    "json5": "^2.2.3",
    "marked": "^18.2.1",
    "nodemailer": "^10.6.0",
    "smol-toml": "^1.9.1"
  },
  "scripts": {
    "check": "sh scripts/check.sh",
    "format": "prettier --write . --cache --cache-strategy content",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "prepare": "husky",
    "test": "node --test"
  },
  "lint-staged": {
    "!(*.js|*.cjs|*.mjs)": "prettier --write --ignore-unknown --cache --cache-strategy content",
    "*.{,c,m}js": [
      "prettier --write --cache --cache-strategy content",
      "eslint --no-warn-ignored"
    ]
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "neostandard": "^0.14.1",
    "prettier": "^3.10.1"
  }
}
