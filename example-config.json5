// Copy to ~/.config/christmas-tombola/config.json5 (or config.json5 next to cli.mjs).
{
  email: {
    // Any other Nodemailer message field (bcc, replyTo…) applies to every mail.
    from: { name: "Santa", address: "santa@example.com" },

    // Nodemailer transport: https://nodemailer.com/smtp/
    transport: {
      host: "smtp.example.com",
      port: 465,
      secure: true,
      auth: { user: "santa@example.com", pass: "secret" },
    },
  },

  // SMS Gate app (https://sms-gate.app) in Local Server mode: address and
  // credentials shown in the app. Plain HTTP: use it on a trusted network.
  sms: {
    url: "http://192.168.1.10:8080/message",
    username: "sms",
    password: "secret",

    // Optional: ms without answer before failing (default: 30000).
    // timeout: 30000,
  },
}
